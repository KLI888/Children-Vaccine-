# ==============================================================================
# CHILDREN VACCINE MENTOR — ENVIRONMENT CONFIGURATION
# ==============================================================================
# 💡 ZERO-CONFIG ARCHITECTURE:
# The application is architected to run 100% out of the box with ZERO environment
# variables! Multi-user data isolation, the 12-vaccine schedule engine, three-stage
# reminders, growth tracker, and audio chime simulations all work without any setup.
# ==============================================================================

# --- OPTIONAL: Gemini AI ---
GEMINI_API_KEY=""

# --- OPTIONAL: App Deployment URL ---
APP_URL="http://localhost:3000"

# --- OPTIONAL: Supabase Cloud Database (PostgreSQL) ---
# Only configure these if you want to sync records to a remote Supabase project.
# If left empty, the application uses its built-in isolated database engine.
NEXT_PUBLIC_SUPABASE_URL=""
NEXT_PUBLIC_SUPABASE_ANON_KEY=""
SUPABASE_SERVICE_ROLE_KEY=""

# --- OPTIONAL: Cron Job Protection ---
# Only needed in production if you wish to block unauthorized HTTP requests to /api/cron/process-reminders.
# For college/examiner demonstration, this can be left completely empty.
CRON_SECRET=""

# --- OPTIONAL: External Server-to-Client Web Push (VAPID) ---
# Only needed if you want an external server to send push payloads when user is away without browser interaction.
# Browser notifications and audio chimes work natively without these!
NEXT_PUBLIC_VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
VAPID_SUBJECT="mailto:support@childrenvaccinementor.in"
